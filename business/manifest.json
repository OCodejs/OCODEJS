{
  "schemaVersion": "1.0.0",
  "organization": {
    "name": "OCodeJS",
    "repository": "OCodejs/OCODEJS",
    "website": "https://github.com/OCodejs",
    "description": "OCodeJS open-source software organization and product portfolio."
  },
  "projects": [
    {
      "id": "ocode-js",
      "name": "OCode.js",
      "kind": "library",
      "status": "active-development",
      "description": "A lightweight, dependency-free JavaScript and TypeScript utility toolkit for modern web applications.",
      "repository": "https://github.com/OCodejs/OCODEJS",
      "documentation": "https://github.com/OCodejs/OCODEJS#readme",
      "packageName": "ocode-js",
      "packageVersion": "0.1.0",
      "source": "package.json",
      "visibility": "public"
    }
  ],
  "articles": {
    "sourceDirectory": "_articles",
    "include": "**/*.md",
    "exclude": [
      "**/README.md"
    ],
    "format": "frontmatter-markdown"
  },
  "policy": {
    "sourceOfTruth": "OCodejs/OCODEJS",
    "syncMode": "central-draft-pr",
    "copySecrets": false,
    "overwriteOnlyGeneratedDirectory": true
  }
}
