{
  "name": "ocodejs-framework",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ocodejs-framework",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "@ocodejs/router": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@ocodejs/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@ocodejs/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@ocodejs/router": {
      "resolved": "packages/router",
      "link": true
    },
    "packages/cli": {
      "name": "@ocodejs/cli",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@ocodejs/core": "*"
      },
      "bin": {
        "ocode": "src/index.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/core": {
      "name": "@ocodejs/core",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@ocodejs/router": "*"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/router": {
      "name": "@ocodejs/router",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
