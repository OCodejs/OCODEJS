# OAuth app settings. Never commit real credentials.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
# Comma-separated GitHub usernames allowed to access the Cloud Agent.
GITHUB_ALLOWED_USERS=your-github-login
SESSION_SECRET=replace-with-at-least-32-random-characters
# Existing PostgreSQL only; this project does not provision databases.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
APP_ORIGIN=http://localhost:3000
NODE_ENV=development

# Optional OpenAI-compatible provider. Configure on the worker service too.
# Keep the API key server-side; never use NEXT_PUBLIC_AI_API_KEY.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-provider-key
AI_MODEL=replace-with-model-id

# Multi-provider OAuth callbacks: APP_ORIGIN/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_ALLOWED_USERS=approved-user@example.com
DISCORD_CLIENT_ID=replace-with-discord-oauth-client-id
DISCORD_CLIENT_SECRET=replace-with-discord-oauth-client-secret
DISCORD_ALLOWED_USERS=approved-discord-username
